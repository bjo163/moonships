{
  "name": "moonships-workbench",
  "private": true,
  "version": "0.1.0-2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "typecheck": "tsc -b --pretty false",
    "lint": "biome lint src vite.config.ts index.html && node --check scripts/backlog-sync-core.cjs",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run test:repo && npm test && npm run typecheck && npm run build",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false src vite.config.ts vitest.config.ts index.html",
    "test:repo": "node --test scripts/backlog-sync-core.test.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "@types/node": "^24.0.0",
    "@biomejs/biome": "^2.2.0",
    "vitest": "^3.2.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "jsdom": "^27.0.0"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  }
}
